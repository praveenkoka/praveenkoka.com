{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/:slug(inbox-[a-z0-9]{24})",
      "destination": "/api/inbox?slug=:slug"
    }
  ]
}
